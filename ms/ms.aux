\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces R tools for imputing missing data, against the needs of phylogenetic comparative analysis. \emph  {Phylogeny} (Phylo.): a tree-derived covariance informs the imputation. \emph  {Proper multiple imputation} (MI): multiple imputed datasets (or an integrated Bayesian posterior) are produced, so downstream analyses reflect imputation uncertainty. \emph  {Multilevel} (Multi.): non-independence beyond the phylogeny (random effects / clustered rows). Remaining columns: an explicit imputation model for continuous (Cont.), count, binary (Bin.), ordinal (Ord., treated as ordered) and nominal (Nom., unordered multinomial) variables. ✓ = documented in the package's reference documentation (October 2026); (✓) = partial support; ✗ = not documented.\relax }}{3}{table.1}\protected@file@percent }
\newlabel{tbl-software}{{1}{3}{R tools for imputing missing data, against the needs of phylogenetic comparative analysis. \emph {Phylogeny} (Phylo.): a tree-derived covariance informs the imputation. \emph {Proper multiple imputation} (MI): multiple imputed datasets (or an integrated Bayesian posterior) are produced, so downstream analyses reflect imputation uncertainty. \emph {Multilevel} (Multi.): non-independence beyond the phylogeny (random effects / clustered rows). Remaining columns: an explicit imputation model for continuous (Cont.), count, binary (Bin.), ordinal (Ord., treated as ordered) and nominal (Nom., unordered multinomial) variables. ✓ = documented in the package's reference documentation (October 2026); (✓) = partial support; ✗ = not documented.\relax }{table.1}{}}
\@writefile{toc}{\contentsline {section}{\nonumberline The \emph  {BACE} R package: How it works?}{4}{section*.7}\protected@file@percent }
\newlabel{the-bace-r-package-how-it-works}{{}{4}{\texorpdfstring {The \emph {BACE} R package: How it works?}{The BACE R package: How it works?}}{section*.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Overview of the BACE imputation workflow}. (1) Inputs are an incomplete trait dataset and a phylogeny covering the species. (2) Chained imputation: a separate phylogenetic mixed model is fitted for each incomplete trait, and missing values are updated with point estimates until they stabilise. (3) Final imputation: models are refitted and missing values are drawn from their posterior predictive distributions. Repeated runs produce multiple completed datasets while retaining the observed values. (4) Downstream analysis: models are fitted to each completed dataset and posterior draws are pooled across imputations. Alternatively, parameter estimates and their variances can be combined using Rubin's rules to include imputation uncertainty.\relax }}{5}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig-bace-workflow}{{1}{5}{\textbf {Overview of the BACE imputation workflow}. (1) Inputs are an incomplete trait dataset and a phylogeny covering the species. (2) Chained imputation: a separate phylogenetic mixed model is fitted for each incomplete trait, and missing values are updated with point estimates until they stabilise. (3) Final imputation: models are refitted and missing values are drawn from their posterior predictive distributions. Repeated runs produce multiple completed datasets while retaining the observed values. (4) Downstream analysis: models are fitted to each completed dataset and posterior draws are pooled across imputations. Alternatively, parameter estimates and their variances can be combined using Rubin's rules to include imputation uncertainty.\relax }{figure.caption.5}{}}
